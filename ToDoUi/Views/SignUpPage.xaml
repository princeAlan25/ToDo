<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ToDoUi.Views.SignUpPage"
			 xmlns:viewModels="clr-namespace:ToDoUi.ViewModels"
             Title=""
			 x:DataType="viewModels:SignUpViewModel" Shell.NavBarIsVisible="False" Shell.TabBarIsVisible="False">

	<FlexLayout HorizontalOptions="Center" 
				VerticalOptions="Center" 
				Direction="Column"
				AlignItems="Center">

		<Image Source="todoapplogo.png" WidthRequest="100" HeightRequest="100" HorizontalOptions="Center" />
		<Label Text="TaskSpace SignUp" TextColor="RoyalBlue" />

		<VerticalStackLayout>
			<FlexLayout Direction="Column" 
					JustifyContent="SpaceEvenly" 
					WidthRequest="500" 
					HeightRequest="300">
				<Entry Placeholder="example@gmail.com" Text="{Binding Email, Mode=TwoWay}" />
				<Label Text="{Binding EmailError, Mode=OneWay}" TextColor="OrangeRed" IsVisible="{Binding HasEmailError, Mode=OneWay}" FontSize="12" />
				<Entry Placeholder="Username" Text="{Binding UserName, Mode=TwoWay}" />
				<Label Text="{Binding UserNameError, Mode=OneWay}" TextColor="OrangeRed" IsVisible="{Binding HasUserNameError, Mode=OneWay}" FontSize="12" />
				<Entry Placeholder="Password" IsPassword="True" Text="{Binding Password, Mode=TwoWay}" />
				<Label Text="{Binding PasswordError, Mode=OneWay}" TextColor="OrangeRed" IsVisible="{Binding HasPasswordError, Mode=OneWay}" FontSize="12" />
				<Button Text="SignUp" HorizontalOptions="Fill" TextColor="White" BackgroundColor="RoyalBlue" Command="{Binding SignUpCommand}" />
			</FlexLayout>
		</VerticalStackLayout>

	</FlexLayout>

</ContentPage>