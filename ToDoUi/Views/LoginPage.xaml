<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
			 xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
			 xmlns:viewModels="clr-namespace:ToDoUi.ViewModels"
             x:Class="ToDoUi.Views.LoginPage"
			 x:DataType="viewModels:LoginViewModel">

	<FlexLayout HorizontalOptions="Center" 
				VerticalOptions="Center" 
				Direction="Column"
				AlignItems="Center">

		<Image Source="todoapplogo.png" WidthRequest="100" HeightRequest="100" HorizontalOptions="Center" />
		<Label Text="Welcome Back to the Plan-Space..." TextColor="RoyalBlue" />

		<VerticalStackLayout>
			<FlexLayout Direction="Column" 
					JustifyContent="SpaceEvenly" 
					WidthRequest="500" 
					HeightRequest="200">

				<Entry Placeholder="example@gmail.com" Text="{Binding Email}" />
				<Label Text="{Binding EmailError, Mode=OneWay}" TextColor="OrangeRed" IsVisible="{Binding HasEmailError, Mode=OneWay}" FontSize="12" />
				<Entry Placeholder="Password" IsPassword="True" Text="{Binding Password}" />
				<Label Text="{Binding PasswordError, Mode=OneWay}" TextColor="OrangeRed" IsVisible="{Binding HasPasswordError, Mode=OneWay}" FontSize="12" />
				<Button Text="LogIn" HorizontalOptions="Fill" TextColor="White" BackgroundColor="RoyalBlue" Command="{Binding LoginCommand}" />
			</FlexLayout>
		</VerticalStackLayout>

	</FlexLayout>

</ContentPage>