<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="ToDoUi.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
	xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
    xmlns:views="clr-namespace:ToDoUi.Views"
	Title="My Todo"
	FlyoutBehavior="Locked"
	FlyoutWidth="250">

	<Shell.FlyoutHeader>
		<Grid ColumnDefinitions="50,*" HorizontalOptions="Fill" Margin="16,0" ColumnSpacing="16" Padding="0,10">
			<ImageButton Source="dotnet_bot.png" WidthRequest="54" HeightRequest="54" CornerRadius="50" BorderWidth="0.5" BorderColor="GhostWhite" VerticalOptions="Center" />
			<VerticalStackLayout Grid.Column="1" HorizontalOptions="Fill" Spacing="1" VerticalOptions="Center">
				<Label Text="User Name" FontSize="14" FontAttributes="Bold" />
				<Label Text="example@gmail.com" FontSize="12" TextColor="Gray" />
			</VerticalStackLayout>
		</Grid>
	</Shell.FlyoutHeader>

	<FlyoutItem 
		Title="My Day" 
		Route="home" 
		FlyoutIcon="{FontImageSource Glyph={mi:Cupertino Icon=SunHaze, IconColor=Grey, IconSize=18}}">
		<ShellContent ContentTemplate="{DataTemplate views:HomePage}" />
	</FlyoutItem>

	<FlyoutItem 
		Title="Important" 
		Route="home" 
		FlyoutIcon="{FontImageSource Glyph={mi:Cupertino Icon=Star, IconColor=DarkOrange, IconSize=18}}" >
		<ShellContent ContentTemplate="{DataTemplate views:HomePage}" />
	</FlyoutItem>

	<FlyoutItem 
		Title="Planned" 
		Route="home" 
		FlyoutIcon="{FontImageSource Glyph={mi:Cupertino Icon=RectanglePaperclip, IconColor=SkyBlue, IconSize=18}}">
		<ShellContent ContentTemplate="{DataTemplate views:HomePage}" />
	</FlyoutItem>

	<FlyoutItem 
		Title="Assigned to me" 
		Route="home" 
		FlyoutIcon="{FontImageSource Glyph={mi:Cupertino Icon=Bookmark, IconColor=SeaGreen, IconSize=18}}">
		<ShellContent ContentTemplate="{DataTemplate views:HomePage}" />
	</FlyoutItem>

	<FlyoutItem 
		Title="Tasks" 
		Route="home" 
		FlyoutIcon="{FontImageSource Glyph={mi:Cupertino Icon=ListBulletBelowRectangle, IconColor=Green, IconSize=18}}">
		<ShellContent ContentTemplate="{DataTemplate views:HomePage}" />
	</FlyoutItem>

	<FlyoutItem 
		Title="Login" 
		Route="login" 
		FlyoutIcon="{FontImageSource Glyph={mi:Cupertino Icon=LockFill, IconColor=Black, IconSize=18}}">
		<ShellContent ContentTemplate="{DataTemplate views:LoginPage}" />
	</FlyoutItem>

	<Shell.FlyoutFooter>
		<FlexLayout JustifyContent="SpaceBetween" Padding="4" BackgroundColor="GhostWhite">
			<HorizontalStackLayout Spacing="2">
				<ImageButton Source="{FontImageSource Glyph={mi:Cupertino Icon=Plus, IconColor=Black}}" VerticalOptions="Center" />
				<Label Text="New List" VerticalOptions="Center" TextColor="Black" />
			</HorizontalStackLayout>
			<ImageButton Grid.Column="1" Source="{FontImageSource Glyph={mi:Cupertino Icon=SquareGrid2x2, IconColor=Black, IconSize=18}}" HorizontalOptions="End" />
		</FlexLayout>
	</Shell.FlyoutFooter>

</Shell>
